#!/bin/bash
set -e

STARTUP_TIMEOUT=${OPENBMP_POSTGRES_STARTUP_TIMEOUT:-60}
INTERVAL=5
elapsed=0

echo "===> Waiting up to ${STARTUP_TIMEOUT}s for Postgres to start ..."

while ! psql -c "SELECT 1;" &>/dev/null; do
    (( elapsed >= STARTUP_TIMEOUT )) && {
        echo "$(cat <<EOF
ERROR: Postgres did not start within ${STARTUP_TIMEOUT}s.
       Ensure Postgres is reachable at ${OPENBMP_POSTGRES_HOST}:${OPENBMP_POSTGRES_PORT},
       and that the credentials are correct.
       Check the Postgres logs for more detailed information.
EOF
)"
        exit 1
    }
    echo "     Postgres is not ready ... (${elapsed}s elapsed)"
    sleep $INTERVAL
    (( elapsed += INTERVAL ))
done

echo "     Postgres is up."
